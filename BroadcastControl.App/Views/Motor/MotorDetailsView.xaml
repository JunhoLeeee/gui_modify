<UserControl x:Class="BroadcastControl.App.Views.Motor.MotorDetailsView"              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
            <Grid Visibility="{Binding IsMotorDetailsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="19">
                <Rectangle Fill="#66000000"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           IsHitTestVisible="True"
                           MouseLeftButtonDown="MotorDetailsBackdrop_OnMouseLeftButtonDown" />
                <Border Width="720"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22"
                    Background="{DynamicResource DrawerBrush}"
                    BorderBrush="{DynamicResource DrawerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Effect="{StaticResource DrawerShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource DrawerTextBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Text="{Binding Text[MotorPosition]}" />
                            <Button Grid.Column="1"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseMotorDetailsCommand}"
                                Style="{StaticResource PlaybackIconButton}">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                Padding="12"
                                Background="{DynamicResource OverlayPanelBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Text="Pan Motor" />
                                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding PanMotorStatusItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1"
                                                               Margin="12,0,0,0"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                Padding="12"
                                Background="{DynamicResource OverlayPanelBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Text="Tilt Motor" />
                                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TiltMotorStatusItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1"
                                                               Margin="12,0,0,0"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
</UserControl>



<UserControl x:Class="BroadcastControl.App.Views.Monitoring.MonitoringView"              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="1.44*" />
                            <RowDefinition Height="1.56*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                          Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="142" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="152" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MinWidth="132">
                                <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Opacity="{Binding RecordingIndicatorOpacity}">
                                    <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding RecordingIndicatorBrush}" />
                                    <TextBlock
                                           Foreground="{Binding RecordingTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="{Binding Text[RecordingOn]}" />
                                </StackPanel>
                                <StackPanel Margin="0,3,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Opacity="{Binding JetsonConnectionOpacity}">
                                    <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding JetsonConnectionBrush}" />
                                    <TextBlock
                                           Foreground="{Binding JetsonConnectionBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="{Binding JetsonConnectionText}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2"
                                Click="OpenRecordedVideosButton_OnClick"
                                Style="{StaticResource TopBarButton}"
                                Content="{Binding Text[RecordedData]}" />
                            <Button Grid.Column="4"
                                Command="{Binding ToggleSettingsCommand}"
                                Style="{StaticResource TopBarButton}"
                                Padding="0" Click="Button_Click_1">
                                <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" />
                            </Button>
                        </Grid>

                        <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                         <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                        <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Style="{StaticResource GlassCardBorder}"
                            CornerRadius="2"
                            Padding="18,12,18,12"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Text[SystemStatus]}" />
                                <StackPanel Margin="0,10,0,5"
                                        Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Text="{Binding CurrentThreatText}" />
                                    <Ellipse Width="14"
                                        Height="14"
                                        Margin="5,5,10,0"
                                        VerticalAlignment="Top"
                                        Fill="{Binding CurrentThreatBrush}" />

                                </StackPanel>
                                <TextBlock Margin="0,5,0,5"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Text="{Binding PrimaryTargetShortText}" />
                            </StackPanel>
                        </Border>

                        <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                         <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                        <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Style="{StaticResource GlassCardBorder}"
                            CornerRadius="2"
                            Padding="18,14,18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Text[AnalysisPanel]}" />
                                </Grid>
                                <ListBox Grid.Row="1"
                                     Margin="0,10,0,0"
                                     ItemsSource="{Binding DetectionTargets}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="DetectionTargetList_OneSelctionChanged">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                Padding="10"
                                                Background="{DynamicResource DrawerItemBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="64"
                                                        Height="48"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="1">
                                                        <Image Source="{Binding Thumbnail}"
                                                            Stretch="UniformToFill" />
                                                    </Border>
                                                    <Grid Grid.Column="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Text="{Binding ClassName}" />
                                                        <TextBlock Grid.Row="1"
                                                            Margin="0,4,0,0"
                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                            FontSize="11"
                                                            Text="{Binding ObjectId, StringFormat='ID {0}'}" />
                                                        <StackPanel Grid.Row="2"
                                                            Margin="0,5,0,0"
                                                            Orientation="Horizontal">
                                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                                FontSize="11"
                                                                Text="{Binding ScoreText}" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                Foreground="{Binding ThreatBrush}"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding ThreatLevel}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                         <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                        <Border Grid.Row="2"
                            Style="{StaticResource GlassCardBorder}"
                            CornerRadius="2"
                            Padding="18,14,18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Text[SystemLog]}" />
                                    <Button Grid.Column="1"
                                        Padding="10,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource TopBarSmallButton}"
                                        Command="{Binding SaveSystemLogsCommand}"
                                        Content="{Binding Text[Save]}" />
                                </Grid>
                                <ListBox Grid.Row="1"
                                     Margin="0,10,0,0"
                                     ItemsSource="{Binding SystemLogs}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                Padding="12"
                                                Background="{DynamicResource DrawerItemBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="1">
                                                <StackPanel>
                                                    <TextBlock Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="11"
                                                           Text="{Binding Time}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="14"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Message}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
</UserControl>

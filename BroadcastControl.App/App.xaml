<!-- 앱 전역 테마, 색상, 공통 컨트롤 스타일을 정의합니다. -->
<Application x:Class="BroadcastControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="Teal"
                                             SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
                 <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF161B24" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF242A35" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF464E5D" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFE09A36" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFE5B057" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF64C59A" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF0F3F8" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFC7CDD8" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF0C1018" />
            <SolidColorBrush x:Key="OverlayPanelBrush" Color="#DD111722" />
            <SolidColorBrush x:Key="DrawerBrush" Color="#FF202631" />
            <SolidColorBrush x:Key="DrawerBorderBrush" Color="#FF465061" />
            <SolidColorBrush x:Key="DrawerTextBrush" Color="#FFF0F3F8" />
            <SolidColorBrush x:Key="DrawerItemBrush" Color="#FF2C3442" />
            <SolidColorBrush x:Key="DrawerItemBorderBrush" Color="#FF4A5567" />
            <SolidColorBrush x:Key="TopBarButtonBrush" Color="#FF2E3643" />
            <SolidColorBrush x:Key="TopBarButtonHoverBrush" Color="#FF394353" />
            <SolidColorBrush x:Key="TopBarButtonPressedBrush" Color="#FF465164" />

            <!-- 화면 구성 요소의 역할을 설명하는 주석입니다. -->
            <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FF1C2230" />
                <GradientStop Offset="0.08" Color="#FF1A2742" />
                <GradientStop Offset="0.16" Color="#FF141A25" />
                <GradientStop Offset="1" Color="#FF161B24" />
            </LinearGradientBrush>

            <!-- Window-level control styles moved from MainWindow for split views. -->
                    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

                    <DropShadowEffect x:Key="SoftPanelShadow"
                                      BlurRadius="10"
                                      ShadowDepth="1"
                                      Direction="270"
                                      Opacity="0.12"
                                      Color="#66000000" />

                    <DropShadowEffect x:Key="TopBarShadow"
                                      BlurRadius="6"
                                      ShadowDepth="0"
                                      Direction="270"
                                      Opacity="0.12"
                                      Color="#66000000" />

                    <DropShadowEffect x:Key="DrawerShadow"
                                      BlurRadius="10"
                                      ShadowDepth="1"
                                      Direction="270"
                                      Opacity="0.10"
                                      Color="#66000000" />

                    <Style x:Key="GlassCardBorder" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="2" />
                        <Setter Property="Effect" Value="{StaticResource SoftPanelShadow}" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                    </Style>

                    <Style x:Key="OverlayCardBorder" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource OverlayPanelBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="2" />
                    </Style>

                    <Style x:Key="TopBarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="14,8" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="{DynamicResource TopBarButtonBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TopBarButtonHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TopBarButtonPressedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="TopBarSmallButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Height" Value="24" />
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="{DynamicResource TopBarButtonBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TopBarButtonHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TopBarButtonPressedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="TopBarCompactSlider" TargetType="Slider">
                        <Setter Property="Height" Value="14" />
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Width" Value="44" />
                        <Setter Property="Height" Value="44" />
                        <Setter Property="Opacity" Value="0.9" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="{DynamicResource OverlayPanelBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
                    </Style>

                    <Style x:Key="MotorPadButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Width" Value="34" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="#33475663" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55475663" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#66475663" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="InlineRotateButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="#00FFFFFF" />
                        <Setter Property="BorderBrush" Value="#55FFFFFF" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F475663" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33475663" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="PlaybackIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Width" Value="42" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="#22313A46" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33475663" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#55475663" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="PanelTitle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="FontSize" Value="18" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>

                    <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="{DynamicResource DrawerItemBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DrawerItemBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource DrawerTextBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
                    </Style>

                    <Style x:Key="SettingsCompactLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DrawerTextBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                    </Style>

                    <Style x:Key="SettingsCompactTextBox" TargetType="TextBox">
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Foreground" Value="{DynamicResource DrawerTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource DrawerItemBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DrawerItemBorderBrush}" />
                        <Setter Property="CaretBrush" Value="{DynamicResource DrawerTextBrush}" />
                        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>

                    <Style x:Key="SettingsCompactComboBox" TargetType="ComboBox">
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Foreground" Value="#FF111827" />
                        <Setter Property="Background" Value="{DynamicResource DrawerItemBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DrawerItemBorderBrush}" />
                        <Setter Property="TextElement.Foreground" Value="#FF111827" />
                        <Setter Property="TextElement.FontSize" Value="14" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="ItemTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                        Padding="8,4"
                                        FontSize="14"
                                        Foreground="#FF111827" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ItemContainerStyle">
                            <Setter.Value>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#FF111827" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TopBarButtonHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TopBarButtonPressedBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="ZoomSliderStyle" TargetType="Slider">
                        <Setter Property="Height" Value="14" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                            </Setter.Value>
                        </Setter>
                    </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
